# ============================================================
# ArchVision AI — environment configuration
# Copy to .env and fill in the values below.
# ============================================================

# --- Database (PostgreSQL 15+) ---
DATABASE_URL="postgresql://CHANGE_ME_user:CHANGE_ME_password@localhost:5432/archvision"

# --- Authentication ---
# Required in production — the app refuses to start without it.
NEXTAUTH_SECRET="generate-with-`openssl rand -base64 32`"

# GitHub OAuth app: https://github.com/settings/developers
# When both keys are set, demo access is disabled in production.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Providers ---
# Set at least one. When both are unset the app runs in offline mode
# with ArchVision's local extraction engine (fully functional, no keys).
# Keep placeholders ("sk-...") EMPTY — a non-empty placeholder is treated
# as a configured key and silently breaks the SSE stream.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage mode ---
# "db"  -> PostgreSQL via the REST API (Prisma). Requires DATABASE_URL + `npm run db:migrate`.
# unset -> localStorage (zero-infra demo). Default.
NEXT_PUBLIC_DATA_MODE="db"

# --- Rate limiting ---
# Every API route is throttled per signed-in user. RATE_LIMITER selects the
# implementation: "memory" (default, process-local sliding window — fine
# for single-instance deployments) or "upstash" (Redis-backed, horizontally
# safe; requires UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN).

# --- Observability (Phase 2) — all optional, inert when unset ---
# Sentry error tracking (server + browser). Sourcemap upload additionally
# needs SENTRY_ORG + SENTRY_PROJECT + SENTRY_AUTH_TOKEN at build time.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# PostHog product analytics — only 4 events (see lib/analytics.ts).
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# --- AI cost controls (Phase 3) ---
# AI_PROVIDER_DISABLED=true stops all provider calls without a redeploy
# (routes return 503 and clients use their offline engines).
AI_PROVIDER_DISABLED=""
# Per-user daily AI request budget across chat + describe. 0/empty = unlimited.
AI_DAILY_REQUEST_BUDGET=""
