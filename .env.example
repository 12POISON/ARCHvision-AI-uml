# ============================================================
# ArchVision AI — environment configuration
# Copy to .env and fill in the values below.
# ============================================================

# --- Database ---
# SQLite used for local demo (zero-infra). PostgreSQL 15 recommended for production.
DATABASE_URL="postgresql://user:password@localhost:5432/archvision"
DIRECT_URL="postgresql://user:password@localhost:5432/archvision"

# --- Redis (queue, cache, rate limiting) ---
REDIS_URL="redis://localhost:6379"

# --- Authentication ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-`openssl rand -base64 32`"

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth app: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI Providers ---
# Set at least one. When both are unset the app runs in offline mode
# with ArchVision's local extraction engine (fully functional, no keys).
# Keep placeholders ("sk-...") EMPTY — a non-empty placeholder is treated
# as a configured key and silently breaks the SSE stream.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- AI sidebar mode banner (build-time, inlined into the client) ---
# "openai" | "anthropic" | unset (offline). Mirrors the keys above for the UI.
NEXT_PUBLIC_AI_PROVIDER="offline"

# --- Object storage (exported diagrams, avatars) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
# or Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Encryption (32-byte hex key for AES-256-GCM secrets at rest) ---
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage mode ---
# "db"  -> PostgreSQL via /api/storage (Prisma). Requires DATABASE_URL + `npm run db:migrate`.
# unset -> localStorage (zero-infra demo). Default.
NEXT_PUBLIC_DATA_MODE="db"

# --- Monitoring ---
SENTRY_DSN=""